#!/usr/bin/env bash
set -u
PORT="${HOMESCREEN_PORT:-5555}"
MODEL="${HOMESCREEN_MODEL:-24129PN74G}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/homescreen-plus"
STATUS="$CACHE/status-$"
SPLASH_PID=""
cleanup() { rm -f "$STATUS"; }
trap cleanup EXIT
status() { printf '%s\n' "$1" > "$STATUS"; }
mkdir -p "$CACHE"
exec 9>"$CACHE/launcher.lock"
flock -n 9 || exit 0
START_MS=$(date +%s%3N)
MIN_SPLASH_MS="${HOMESCREEN_SPLASH_MS:-3000}"
status searching
if command -v python3 >/dev/null && [[ -f "${HOMESCREEN_SPLASH:-$HOME/.local/share/homescreen-plus/splash.py}" ]]; then
    python3 "${HOMESCREEN_SPLASH:-$HOME/.local/share/homescreen-plus/splash.py}" "$STATUS" >/dev/null 2>&1 &
    SPLASH_PID=$!
fi
check_phone() {
    local ip="$1" target model
    [[ -n "$ip" ]] || return 1
    target="$ip:$PORT"
    status "connecting:$ip"
    adb connect "$target" >/dev/null 2>&1 || true
    [[ "$(adb -s "$target" get-state 2>/dev/null)" == device ]] || { status searching; return 1; }
    model=$(adb -s "$target" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
    if [[ "$model" == *"$MODEL"* ]]; then
        FOUND="$ip"
        return 0
    fi
    status searching
    return 1
}
FOUND=""
if [[ -f "$CACHE/phone-ip" ]]; then
    check_phone "$(cat "$CACHE/phone-ip")" || true
fi
if [[ -z "$FOUND" ]]; then
    while read -r target state; do
        if [[ "$target" == *":$PORT" && "$state" == device ]]; then
            check_phone "${target%:$PORT}" && break
        fi
    done < <(adb devices | tail -n +2)
fi
if [[ -z "$FOUND" ]]; then
    while read -r subnet; do
        while read -r ip; do
            if check_phone "$ip"; then break 2; fi
        done < <(nmap -n -sT -p "$PORT" --open -oG - "$subnet" | awk -v p="$PORT" '$0 ~ p"/open" {print $2}')
    done < <(ip -4 route show scope link | awk '$1 ~ /^[0-9]+\./ && $1 ~ /\// {print $1}' | sort -u)
fi
if [[ -z "$FOUND" ]]; then
    status notfound
    sleep 2.5
    echo "Android model $MODEL not found on directly connected IPv4 networks." >&2
    exit 1
fi
printf '%s\n' "$FOUND" > "$CACHE/phone-ip"
elapsed=$(( $(date +%s%3N) - START_MS ))
if (( elapsed < MIN_SPLASH_MS )); then
    sleep "$(awk -v ms="$((MIN_SPLASH_MS - elapsed))" 'BEGIN { printf "%.3f", ms/1000 }')"
fi
status launching
sleep 0.7
cleanup
trap - EXIT
export SDL_APP_ID=homescreen-plus
export SDL_VIDEO_WAYLAND_WMCLASS=homescreen-plus
export SDL_VIDEO_X11_WMCLASS=homescreen-plus
SCRCPY_OPTS=(--window-title 'HomeScreen +')
# Keep the device awake through normal activity during a mirroring session.
if [[ "${HOMESCREEN_KEEP_ACTIVE:-1}" == 1 ]]; then
    SCRCPY_OPTS+=(--keep-active)
fi
# scrcpy powers on the display by default. Allow disabling this.
if [[ "${HOMESCREEN_NO_POWER_ON:-0}" == 1 ]]; then
    SCRCPY_OPTS+=(--no-power-on)
fi
NOTICE_PID=""
if [[ "${HOMESCREEN_UNLOCK_NOTICE:-1}" == 1 && -f "$HOME/.local/share/homescreen-plus/lock_notice.py" ]]; then
    python3 "$HOME/.local/share/homescreen-plus/lock_notice.py" "$FOUND:$PORT" >/dev/null 2>&1 &
    NOTICE_PID=$!
fi
stop_notice() {
    if [[ -n "$NOTICE_PID" ]]; then
        kill "$NOTICE_PID" 2>/dev/null || true
        wait "$NOTICE_PID" 2>/dev/null || true
    fi
}
trap stop_notice EXIT
scrcpy -s "$FOUND:$PORT" "${SCRCPY_OPTS[@]}"
